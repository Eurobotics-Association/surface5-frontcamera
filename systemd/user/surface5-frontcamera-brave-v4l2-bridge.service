[Unit]
Description=Expose the Surface 5 front camera to Brave through V4L2 loopback
After=graphical-session.target wireplumber.service
Wants=wireplumber.service

[Service]
Type=simple
ExecStartPre=/usr/bin/test -c /dev/video20
ExecStart=/usr/bin/gst-launch-1.0 -q pipewiresrc target-object=libcamera_input.__SB_.PCI0.I2C2.CAMF client-name=surface5-frontcamera-brave-v4l2-bridge ! video/x-raw,format=NV12,width=1280,height=720 ! queue max-size-buffers=4 leaky=downstream ! videoconvert ! video/x-raw,format=YUY2,width=1280,height=720,framerate=30/1 ! v4l2sink device=/dev/video20 sync=false
Restart=on-failure
RestartSec=3
